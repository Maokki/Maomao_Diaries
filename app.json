{
  "expo": {
    "name": "Maomao Diaries",
    "slug": "Maomao-Diaries",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/maomao_icon-192.png",
    "scheme": "maomaodiaries",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/maomao_icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/maomao_icon-512.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nagiiiqt.MaomaoDiaries",
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/19f78d82-ea9e-42bc-a93c-71df133a4e46"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/maomao_icon-512.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Maomao needs access to your gallery to attach photos to your diary.",
          "cameraPermission": "Maomao needs camera access to take a photo for your diary."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19f78d82-ea9e-42bc-a93c-71df133a4e46"
      }
    },
    "owner": "nagiiiqt"
  }
}